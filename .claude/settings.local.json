{
  "permissions": {
    "allow": [
      "Bash(python TTMPC_THESIS/src/server/migration/_check_savings.py TTMPC-212)",
      "Bash(node verify_members_profile.mjs)",
      "Read(//c/Users/User/AppData/Local/Temp/**)",
      "Bash(curl -s http://127.0.0.1:8000/api/bookkeeper/manage-loans -o api.json)",
      "Bash(python -c ' *)",
      "Bash(cd /c/Users/User/Desktop/TTMPC-Thesis/TTMPC_THESIS && grep -l \"loading\\\\|error\\\\|empty\\\\|skeleton\" src/*/Components/*.jsx | head -15)",
      "Read(//c/c/Users/User/Desktop/TTMPC-Thesis/TTMPC_THESIS/**)",
      "Bash(npx eslint *)",
      "Bash(npm run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
