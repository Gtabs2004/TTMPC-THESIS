      <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
      <script>
        (function () {
          const root = document.getElementById("root");
          const world = document.getElementById("f11-world");
          const W = 1920, H = 1080;

          // ---------- measure targets BEFORE any tween touches them ----------
          function centerOffset(el) {
            const r = el.getBoundingClientRect();
            const rr = root.getBoundingClientRect();
            return {
              x: (r.left - rr.left) + r.width / 2 - W / 2,
              y: (r.top - rr.top) + r.height / 2 - H / 2,
            };
          }
          function poseFor(el, scale) {
            const o = centerOffset(el);
            return { scale: scale, x: -o.x * scale, y: -o.y * scale };
          }
          function centerOf(el) {
            const r = el.getBoundingClientRect();
            const rr = root.getBoundingClientRect();
            return {
              x: (r.left - rr.left) + r.width / 2,
              y: (r.top - rr.top) + r.height / 2,
            };
          }
          // local center of targetEl in parentEl's own box (parentEl is the
          // nearest positioned ancestor of the element being placed)
          function localCenter(targetEl, parentEl) {
            const tr = targetEl.getBoundingClientRect();
            const pr = parentEl.getBoundingClientRect();
            return { x: tr.left - pr.left + tr.width / 2, y: tr.top - pr.top + tr.height / 2 };
          }

          const phoneCardEl = document.getElementById("f11-phone-card");
          const queueRowEl = document.getElementById("f11-queue-row");
          const duoBoundsEl = document.getElementById("f11-duo-bounds");
          const submitBtnEl = document.getElementById("f11-submit-btn");
          const approveBtnEl = document.getElementById("f11-approve-btn");
          const tapEl = document.getElementById("f11-tap");

          const poseWide = { scale: 1, x: 0, y: 0 };
          const posePhoneDive = poseFor(phoneCardEl, 2.35);
          const poseRowLand = poseFor(queueRowEl, 2.15);
          const posePhoneReturn = poseFor(phoneCardEl, 2.3);
          const poseSettle = poseFor(duoBoundsEl, 1.12);

          const approvePt = centerOf(approveBtnEl);
          // .f11-tap's positioned ancestor is .f11-phone-card, not #root — place it
          // in that local coordinate space, then bake centering via xPercent/yPercent
          // (never mix a static CSS `transform` with a GSAP-animated transform prop).
          const tapPt = localCenter(submitBtnEl, phoneCardEl);
          tapEl.style.left = tapPt.x + "px";
          tapEl.style.top = tapPt.y + "px";
          gsap.set(tapEl, { xPercent: -50, yPercent: -50, scale: 0 });
          gsap.set(["#f11-ripple-1", "#f11-ripple-2"], { xPercent: -50, yPercent: -50, scale: 0 });
          gsap.set("#f11-eyebrow", { xPercent: -50 });

          // ---------- single-writer camera composition ----------
          const cam = { scale: 1, x: 0, y: 0 };
          const drift = { x: 0, y: 0 };
          function applyCamera() {
            world.style.transform =
              "translate(" + (cam.x + drift.x) + "px, " + (cam.y + drift.y) + "px) scale(" + cam.scale + ")";
          }
          applyCamera();

          // ---------- motion-blur streak on the world wrapper (Camera-Travel Carve-Out) ----------
          // axis: 'b' = "v v" (symmetric depth blur for a dive/push leg), 'x' = "v 0" (lateral
          // smear for a repositioning travel leg). Directional SVG feGaussianBlur, proxy-tweened.
          const blurNode = document.getElementById("f11-streak-blur");
          const blurProxy = { v: 0, axis: "b" };
          function writeBlur() {
            const sd = blurProxy.axis === "x" ? blurProxy.v + " 0" : blurProxy.v + " " + blurProxy.v;
            blurNode.setAttribute("stdDeviation", sd);
          }
          writeBlur();

          const tl = gsap.timeline({ paused: true });
          window.__timelines = window.__timelines || {};

          // ================= LEG 0 — seed wide, both devices visible =================
          tl.set(cam, poseWide, 0);
          tl.fromTo(
            "#f11-eyebrow",
            { opacity: 0, y: -10 },
            { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" },
            0.05
          );

          // ================= LEG 1 — dive tight onto the phone card =================
          tl.set(blurProxy, { v: 18, axis: "b" }, 0.05);
          tl.to(cam, { scale: posePhoneDive.scale, x: posePhoneDive.x, y: posePhoneDive.y, duration: 0.9, ease: "power4.out" }, 0.05);
          tl.to(blurProxy, { v: 0, duration: 0.9, ease: "power4.out", onUpdate: writeBlur }, 0.05);

          // ---- hinge: member taps Submit (~1.0 - 2.9s) ----
          tl.fromTo(
            "#f11-tap",
            { opacity: 0, scale: 0 },
            { opacity: 1, scale: 1, duration: 0.4, ease: "power2.out" },
            1.35
          );
          tl.to("#f11-tap", { opacity: 0, duration: 0.35, ease: "power1.out" }, 1.75);
          tl.to(submitBtnEl, { opacity: 0.35, duration: 0.3, ease: "power1.out" }, 1.45);
          tl.fromTo(
            "#f11-card-pulse",
            { opacity: 0.7, scale: 0.94 },
            { opacity: 0, scale: 1.18, duration: 0.65, ease: "power2.out" },
            1.45
          );
          tl.fromTo(
            "#f11-phone-pill-pending",
            { opacity: 0, scale: 0.6, y: 6 },
            { opacity: 1, scale: 1, y: 0, duration: 0.4, ease: "back.out(1.5)" },
            1.5
          );

          // ================= LEG 2 — travel across to the desktop queue =================
          tl.set(blurProxy, { axis: "x" }, 3.0);
          tl.to(cam, { scale: poseRowLand.scale, x: poseRowLand.x, y: poseRowLand.y, duration: 3.3, ease: "power2.inOut" }, 3.0);
          tl.fromTo(blurProxy, { v: 0 }, { v: 16, duration: 1.65, ease: "power2.in", onUpdate: writeBlur }, 3.0);
          tl.to(blurProxy, { v: 0, duration: 1.65, ease: "power2.out", onUpdate: writeBlur }, 4.65);
          tl.to("#f11-eyebrow", { opacity: 0.3, duration: 0.5, ease: "power2.out" }, 3.0);

          // traveling data-flow particles, phone -> desktop
          [
            { id: "f11-particle-1", start: 3.15 },
            { id: "f11-particle-2", start: 3.65 },
          ].forEach((p) => {
            const el = document.getElementById(p.id);
            const proxy = { d: 0 };
            tl.set(el, { opacity: 1 }, p.start);
            tl.fromTo(
              proxy,
              { d: 0 },
              {
                d: 100,
                duration: 1.3,
                ease: "power1.inOut",
                onUpdate: function () {
                  el.style.offsetDistance = proxy.d + "%";
                },
              },
              p.start
            );
            tl.to(el, { opacity: 0, duration: 0.25, ease: "power1.in" }, p.start + 1.15);
          });

          // ---- row lands + gets reviewed/approved ----
          tl.fromTo(
            "#f11-queue-row",
            { opacity: 0, y: 16, scale: 0.85 },
            { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "back.out(1.35)" },
            5.85
          );
          tl.to("#f11-eyebrow", { opacity: 0.8, duration: 0.4, ease: "power2.out" }, 6.0);

          // officer cursor click-ripple on Approve
          tl.set("#f11-cursor-officer", { x: approvePt.x - 130, y: approvePt.y - 90, opacity: 1 }, 6.1);
          tl.to("#f11-cursor-officer", { x: approvePt.x - 6, y: approvePt.y - 4, duration: 0.4, ease: "power3.out" }, 6.15);
          tl.to("#f11-cursor-officer", { scale: 0.82, duration: 0.08, ease: "power2.in", yoyo: true, repeat: 1 }, 6.58);
          tl.to("#f11-approve-btn", { scale: 0.93, duration: 0.08, ease: "power2.in", yoyo: true, repeat: 1 }, 6.58);
          [
            { id: "f11-ripple-1", stagger: 0 },
            { id: "f11-ripple-2", stagger: 0.08 },
          ].forEach((r) => {
            tl.set("#" + r.id, { x: approvePt.x, y: approvePt.y, opacity: 1 }, 6.62 + r.stagger);
            tl.to(
              "#" + r.id,
              { scale: 4, opacity: 0, duration: 0.6, ease: "power2.out" },
              6.62 + r.stagger
            );
          });
          tl.to("#f11-cursor-officer", { opacity: 0, duration: 0.3, ease: "power1.out" }, 6.9);
          tl.to("#f11-row-pill-new", { opacity: 0, duration: 0.25, ease: "power1.out" }, 6.68);
          tl.fromTo(
            "#f11-row-pill-approved",
            { opacity: 0, scale: 0.7 },
            { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(1.5)" },
            6.72
          );
          tl.fromTo(
            "#f11-row-check",
            { opacity: 0, scale: 0.4 },
            { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(1.6)" },
            6.75
          );
          tl.to(
            "#f11-check-path",
            { strokeDashoffset: 0, duration: 0.35, ease: "power2.out" },
            6.8
          );

          // ================= LEG 3 — travel back to the phone =================
          tl.set(blurProxy, { axis: "x" }, 7.0);
          tl.to(cam, { scale: posePhoneReturn.scale, x: posePhoneReturn.x, y: posePhoneReturn.y, duration: 3.2, ease: "power2.inOut" }, 7.0);
          tl.fromTo(blurProxy, { v: 0 }, { v: 16, duration: 1.6, ease: "power2.in", onUpdate: writeBlur }, 7.0);
          tl.to(blurProxy, { v: 0, duration: 1.6, ease: "power2.out", onUpdate: writeBlur }, 8.6);
          tl.to("#f11-eyebrow", { opacity: 0.3, duration: 0.5, ease: "power2.out" }, 7.0);

          // traveling particles, desktop -> phone
          [
            { id: "f11-particle-1", start: 7.15 },
            { id: "f11-particle-2", start: 7.65 },
          ].forEach((p) => {
            const el = document.getElementById(p.id);
            const proxy = { d: 100 };
            tl.set(el, { opacity: 1 }, p.start);
            tl.fromTo(
              proxy,
              { d: 100 },
              {
                d: 0,
                duration: 1.3,
                ease: "power1.inOut",
                onUpdate: function () {
                  el.style.offsetDistance = proxy.d + "%";
                },
              },
              p.start
            );
            tl.to(el, { opacity: 0, duration: 0.25, ease: "power1.in" }, p.start + 1.15);
          });

          // ---- phone status updates: Pending -> Approved ----
          tl.to("#f11-eyebrow", { opacity: 0.85, duration: 0.4, ease: "power2.out" }, 9.95);
          tl.fromTo(
            "#f11-card-pulse",
            { opacity: 0.6, scale: 0.94 },
            { opacity: 0, scale: 1.2, duration: 0.7, ease: "power2.out", immediateRender: false },
            10.0
          );
          tl.to("#f11-phone-pill-pending", { opacity: 0, scale: 0.85, duration: 0.35, ease: "power1.out" }, 10.05);
          tl.fromTo(
            "#f11-phone-pill-approved",
            { opacity: 0, scale: 0.6, y: 6 },
            { opacity: 1, scale: 1, y: 0, duration: 0.4, ease: "back.out(1.5)" },
            10.15
          );

          // ================= LEG 4 — settle on the connected pair =================
          tl.to(cam, { scale: poseSettle.scale, x: poseSettle.x, y: poseSettle.y, duration: 1.0, ease: "power3.out" }, 10.5);
          tl.to("#f11-eyebrow", { opacity: 1, duration: 0.5, ease: "power2.out" }, 10.6);

          // one last small pulse along the connector on the hold, reaffirming the link
          (function () {
            const el = document.getElementById("f11-particle-1");
            const proxy = { d: 0 };
            tl.set(el, { opacity: 1 }, 11.4);
            tl.fromTo(
              proxy,
              { d: 0 },
              {
                d: 100,
                duration: 0.5,
                ease: "power1.inOut",
                onUpdate: function () {
                  el.style.offsetDistance = proxy.d + "%";
                },
              },
              11.4
            );
            tl.to(el, { opacity: 0, duration: 0.2, ease: "power1.in" }, 11.85);
          })();

          // ---------- continuous micro-drift (single writer for the whole 12s) ----------
          const driftDriver = { p: 0 };
          tl.to(
            driftDriver,
            {
              p: Math.PI * 2 * 2.2,
              duration: 12,
              ease: "none",
              onUpdate: function () {
                drift.x = Math.sin(driftDriver.p) * 4;
                drift.y = Math.sin(driftDriver.p * 1.3) * 2.4;
                applyCamera();
              },
            },
            0
          );

          window.__timelines["11-connected-system"] = tl;
        })();
      </script>
    </template>
