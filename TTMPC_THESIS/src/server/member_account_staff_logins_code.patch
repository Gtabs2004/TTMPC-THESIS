+@app.post("/api/admin/accounts/staff")
+def create_staff_login(
+    payload: StaffLoginCreateRequest,
+    current_user: dict = _Depends(_get_current_user),
+):
+    """BOD adds a staff (admin) login for an existing member. The member's own
+    login is left exactly as it is."""
+    if supabase is None:
+        raise HTTPException(status_code=500, detail="Supabase client is not initialized.")
+    _require_bod(current_user)
+
+    role = str(payload.role or "").strip().lower()
+    if role not in STAFF_ROLES:
+        raise HTTPException(status_code=400, detail=f"'{payload.role}' is not a staff role.")
+    membership_id = str(payload.membership_id or "").strip()
+    member = resolve_member_by_ref(membership_id)
+    if not member:
+        raise HTTPException(status_code=404, detail=f"Member {membership_id} not found.")
+    if str(member.get("member_status") or "").strip().lower() == "terminated":
+        raise HTTPException(status_code=400, detail="This member is terminated.")
+
+    email = _validate_new_login(payload.email, payload.password)
+    auth_user_id = _create_auth_login(email, payload.password, role=role, membership_id=membership_id)
+
+    try:
+        inserted = (
+            supabase.table("member_account").insert({
+                "membership_id": membership_id,
+                "user_id": None,
+                "auth_user_id": auth_user_id,
+                "email": email,
+                "role": _role_label(role),
+                "is_temporary": False,
+                "is_email_dummy": False,
+                "is_active": True,
+            }).execute()
+        ).data or []
+    except Exception as err:
+        # The auth user is left in place (deleting auth users cascades through
+        # a cleanup trigger); /api/admin/backfill-member-auth can relink it.
+        raise HTTPException(status_code=500, detail=f"Login created but saving the account failed: {err}")
+
+    return {"success": True, "data": (inserted or [None])[0]}
+
