+def _set_login_active(row: dict, is_active: bool) -> None:
+    """Flip is_active AND actually block/unblock sign-in.
+
+    is_active alone is not checked anywhere at login, so a deactivated account
+    could still sign in. A Supabase Auth ban is what really stops it (and also
+    stops refreshing an existing session).
+    """
+    supabase.table("member_account").update({"is_active": bool(is_active)}).eq("id", row["id"]).execute()
+    auth_user_id = row.get("auth_user_id")
+    if auth_user_id:
+        try:
+            supabase.auth.admin.update_user_by_id(
+                auth_user_id, {"ban_duration": "none" if is_active else "876000h"}
+            )
+        except Exception as exc:
+            logger.warning("Could not %s auth user %s: %s", "unban" if is_active else "ban", auth_user_id, exc)
+
+
+def _set_all_logins_active(membership_id: str, is_active: bool) -> None:
+    for row in _member_logins(membership_id):
+        try:
+            _set_login_active(row, is_active)
+        except Exception as exc:
+            logger.warning("Could not update login %s: %s", row.get("id"), exc)
+
