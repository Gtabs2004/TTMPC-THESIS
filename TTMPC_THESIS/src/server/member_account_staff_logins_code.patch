+@app.post("/api/admin/accounts/member-login")
+def create_member_login(
+    payload: MemberLoginCreateRequest,
+    current_user: dict = _Depends(_get_current_user),
+):
+    """Give a member their own member-portal login when they have none (e.g.
+    the 6 staff whose only login used to be their staff login)."""
+    if supabase is None:
+        raise HTTPException(status_code=500, detail="Supabase client is not initialized.")
+    _require_bod(current_user)
+
+    membership_id = str(payload.membership_id or "").strip()
+    member = resolve_member_by_ref(membership_id)
+    if not member:
+        raise HTTPException(status_code=404, detail=f"Member {membership_id} not found.")
+
+    existing = next((r for r in _member_logins(membership_id) if _is_member_login(r)), None)
+    if existing and existing.get("auth_user_id"):
+        raise HTTPException(status_code=409, detail="This member already has a member login.")
+
+    clean_email = str(payload.email or "").strip().lower()
+    if not _EMAIL_RE_AS.match(clean_email):
+        raise HTTPException(status_code=400, detail="Enter a valid email address.")
+    problem = _validate_password_strength(payload.password or "")
+    if problem:
+        raise HTTPException(status_code=400, detail=problem)
+    if _email_in_use(clean_email, except_id=(existing or {}).get("id")):
+        raise HTTPException(status_code=409, detail=f"{clean_email} is already used by another account.")
+
+    auth_user_id = _create_auth_login(clean_email, payload.password, role="member", membership_id=membership_id)
+
+    # is_temporary: the member is sent through the password-change step on
+    # their first sign-in, same as every other newly issued member login.
+    fields = {
+        "auth_user_id": auth_user_id,
+        "email": clean_email,
+        "is_email_dummy": clean_email.endswith("@ttmpc.local"),
+        "is_temporary": True,
+        "is_active": True,
+    }
+    try:
+        if existing:
+            supabase.table("member_account").update(fields).eq("id", existing["id"]).execute()
+        else:
+            supabase.table("member_account").insert({
+                **fields,
+                "membership_id": membership_id,
+                "user_id": member.get("id"),
+                "role": "Member",
+            }).execute()
+    except Exception as err:
+        raise HTTPException(status_code=500, detail=f"Login created but saving the account failed: {err}")
+
+    return {"success": True, "membership_id": membership_id, "email": clean_email}
+
