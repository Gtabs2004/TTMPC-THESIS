+def _email_in_use(email: str, *, except_id: str | None = None) -> bool:
+    rows = (
+        supabase.table("member_account").select("id").ilike("email", email).execute()
+    ).data or []
+    return any(str(r.get("id")) != str(except_id or "") for r in rows)
+
+
+def _create_auth_login(email: str, password: str, *, role: str, membership_id: str) -> str:
+    """Create a confirmed Supabase Auth user and return its id."""
+    try:
+        created = supabase.auth.admin.create_user({
+            "email": email,
+            "password": password,
+            "email_confirm": True,
+            "app_metadata": {"role": role},
+            "user_metadata": {"membership_id": membership_id, "role": _role_label(role)},
+        })
+    except Exception as err:
+        text = str(err).lower()
+        if "already" in text and ("registered" in text or "exists" in text):
+            raise HTTPException(status_code=409, detail=f"{email} already has a login. Use a different email.")
+        raise HTTPException(status_code=502, detail=f"Could not create the login: {err}")
+    auth_user_id = _extract_user_id(getattr(created, "user", None))
+    if not auth_user_id:
+        raise HTTPException(status_code=502, detail="Login was created but no user id was returned.")
+    return auth_user_id
+
+
+def _validate_new_login(email: str, password: str) -> str:
+    clean_email = str(email or "").strip().lower()
+    if not _EMAIL_RE_AS.match(clean_email):
+        raise HTTPException(status_code=400, detail="Enter a valid email address.")
+    problem = _validate_password_strength(password or "")
+    if problem:
+        raise HTTPException(status_code=400, detail=problem)
+    if _email_in_use(clean_email):
+        raise HTTPException(status_code=409, detail=f"{clean_email} is already used by another account.")
+    return clean_email
+
